      <pdfaExtension:schemas>
        <rdf:Bag>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>ESCRIBA Document Part Version</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://ee-consultants.de/2005/escriba#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>ee</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>version</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>ESCRIBA Version</pdfaProperty:description>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>docInfo</pdfaProperty:name>
                  <pdfaProperty:valueType>DocInfo</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>Information about the document itself.</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>DocInfo</pdfaType:type>
                  <pdfaType:namespaceURI>http://ee-consultants.de/2005/escriba/document#</pdfaType:namespaceURI>
                  <pdfaType:prefix>eeDocInfo</pdfaType:prefix>
                  <pdfaType:description>Information about the document.</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>numberOfPages</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>Total number of pages.</pdfaField:description>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>format</pdfaField:name>
                        <pdfaField:valueType>DocumentFormat</pdfaField:valueType>
                        <pdfaField:description>Extra formatting data for document output.</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>DocumentFormat</pdfaType:type>
                  <pdfaType:namespaceURI>http://ee-consultants.de/2005/escriba/document/format#</pdfaType:namespaceURI>
                  <pdfaType:prefix>eeDocFormat</pdfaType:prefix>
                  <pdfaType:description>Output format of the document.</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>printerTray</pdfaField:name>
                        <pdfaField:valueType>TrayFormat</pdfaField:valueType>
                        <pdfaField:description>List of page to printer tray links.</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>TrayFormat</pdfaType:type>
                  <pdfaType:namespaceURI>http://ee-consultants.de/2005/escriba/document/format#</pdfaType:namespaceURI>
                  <pdfaType:prefix>eeDocFormat</pdfaType:prefix>
                  <pdfaType:description>List of page to printer tray links.</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>defaultTray</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>The default tray</pdfaField:description>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>customTrays</pdfaField:name>
                        <pdfaField:valueType>seq CustomTray</pdfaField:valueType>
                        <pdfaField:description>List of custom page to printer tray mappings.,</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>CustomTray</pdfaType:type>
                  <pdfaType:namespaceURI>http://ee-consultants.de/2005/escriba/document/format#</pdfaType:namespaceURI>
                  <pdfaType:prefix>eeDocFormat</pdfaType:prefix>
                  <pdfaType:description>List of page to printer tray links.</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>trayName</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>Name of the output tray.</pdfaField:description>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>pageStart</pdfaField:name>
                        <pdfaField:valueType>Integer</pdfaField:valueType>
                        <pdfaField:description>Start page for custom tray (from)</pdfaField:description>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>pageEnd</pdfaField:name>
                        <pdfaField:valueType>Integer</pdfaField:valueType>
                        <pdfaField:description>End page for custom tray (from)</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:valueType>
          </rdf:li>
        </rdf:Bag>
      </pdfaExtension:schemas>
    </rdf:Description>
    <rdf:Description xmlns:eeData="http://ee-consultants.de/2005/escriba/document/data#" xmlns:eeDocFormat="http://ee-consultants.de/2005/escriba/document/format#" xmlns:eeDocInfo="http://ee-consultants.de/2005/escriba/document#" xmlns:eeSystemInfo="http://ee-consultants.de/2005/escriba/system#" rdf:about="">
      <ee:version xmlns:ee="http://ee-consultants.de/2005/escriba#">http://ee-consultants.de/escriba/xmp/2010_09_13</ee:version>
      <ee:docInfo xmlns:ee="http://ee-consultants.de/2005/escriba#" rdf:parseType="Resource">
        <eeDocInfo:numberOfPages>2</eeDocInfo:numberOfPages>
        <eeDocInfo:format rdf:parseType="Resource">
          <eeDocFormat:printerTray rdf:parseType="Resource">
            <eeDocFormat:defaultTray>Standard</eeDocFormat:defaultTray>
            <eeDocFormat:customTrays>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <eeDocFormat:trayName>$de.eeconsultants.escriba.default.paper.type</eeDocFormat:trayName>
                  <eeDocFormat:pageStart>1</eeDocFormat:pageStart>
                  <eeDocFormat:pageEnd>2</eeDocFormat:pageEnd>
                </rdf:li>
              </rdf:Seq>
            </eeDocFormat:customTrays>
          </eeDocFormat:printerTray>
        </eeDocInfo:format>
      </ee:docInfo>
    </rdf:Description>
